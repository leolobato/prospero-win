diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
index d156160d8d..75090a3bba 100644
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -1612,6 +1612,60 @@ static void track_received_directory( HANDLE handle, int fd )
 #endif
 
 
+#if defined(__PROSPERO__) || defined(PS5_PARK_FILES)
+/* A descriptor the server lends (get_handle_fd's loan) shares its file
+ * position with the server's own, so the server won't close its descriptor
+ * to keep to its budget of open files (see server/fd.c) until the copy is
+ * closed and the loan given back. The loans are kept by descriptor; one past
+ * the table is never given back, which only keeps that file open. */
+#define PS5_LENT_FDS 16384
+static LONG ps5_lent_fds[PS5_LENT_FDS];  /* loan of that descriptor, or 0 */
+
+static void ps5_give_back( unsigned int loan )
+{
+    SERVER_START_REQ( release_fd_loan )
+    {
+        req->loan = loan;
+        wine_server_call( req );
+    }
+    SERVER_END_REQ;
+}
+
+static void ps5_take_loan( int fd, unsigned int loan )
+{
+    LONG old;
+
+    if (fd < 0 || fd >= PS5_LENT_FDS) return;
+    /* a copy closed without server_put_unix_fd had this number before */
+    if ((old = InterlockedExchange( &ps5_lent_fds[fd], loan ))) ps5_give_back( old );
+}
+
+/* the caller keeps the descriptor: its loan is never given back */
+static void ps5_keep_loan( int fd )
+{
+    if (fd >= 0 && fd < PS5_LENT_FDS) InterlockedExchange( &ps5_lent_fds[fd], 0 );
+}
+#endif
+
+
+/***********************************************************************
+ *           server_put_unix_fd
+ *
+ * Close a descriptor from server_get_unix_fd that needs closing.
+ */
+void server_put_unix_fd( int fd )
+{
+#if defined(__PROSPERO__) || defined(PS5_PARK_FILES)
+    LONG loan = (fd >= 0 && fd < PS5_LENT_FDS) ? InterlockedExchange( &ps5_lent_fds[fd], 0 ) : 0;
+
+    close( fd );
+    if (loan) ps5_give_back( loan );
+#else
+    close( fd );
+#endif
+}
+
+
 /***********************************************************************
  *           server_get_unix_fd
  *
@@ -1623,6 +1677,7 @@ int server_get_unix_fd( HANDLE handle, unsigned int wanted_access, int *unix_fd,
     sigset_t sigset;
     obj_handle_t fd_handle;
     int ret, fd = -1;
+    unsigned int loan = 0;
     unsigned int access = 0;
 
     *unix_fd = -1;
@@ -1644,6 +1699,7 @@ int server_get_unix_fd( HANDLE handle, unsigned int wanted_access, int *unix_fd,
                 if (type) *type = reply->type;
                 if (options) *options = reply->options;
                 access = reply->access;
+                loan = reply->loan;
                 if ((fd = wine_server_receive_fd( &fd_handle )) != -1)
                 {
                     assert( wine_server_ptr_handle(fd_handle) == handle );
@@ -1662,6 +1718,11 @@ int server_get_unix_fd( HANDLE handle, unsigned int wanted_access, int *unix_fd,
             }
         }
         SERVER_END_REQ;
+#if defined(__PROSPERO__) || defined(PS5_PARK_FILES)
+        /* a descriptor that didn't arrive is given back at once */
+        if (loan && fd != -1) ps5_take_loan( fd, loan );
+        else if (loan) ps5_give_back( loan );
+#endif
     }
     server_leave_uninterrupted_section( &fd_cache_mutex, &sigset );
 
@@ -1669,7 +1730,7 @@ done:
     if (!ret && ((access & wanted_access) != wanted_access))
     {
         ret = STATUS_ACCESS_DENIED;
-        if (*needs_close) close( fd );
+        if (*needs_close) server_put_unix_fd( fd );
     }
     if (!ret) *unix_fd = fd;
     return ret;
@@ -1724,6 +1785,9 @@ NTSTATUS CDECL wine_server_handle_to_fd( HANDLE handle, unsigned int access, int
     {
         if ((*unix_fd = dup(*unix_fd)) == -1) ret = STATUS_TOO_MANY_OPENED_FILES;
     }
+#if defined(__PROSPERO__) || defined(PS5_PARK_FILES)
+    else if (!ret) ps5_keep_loan( *unix_fd );
+#endif
     return ret;
 }
 
