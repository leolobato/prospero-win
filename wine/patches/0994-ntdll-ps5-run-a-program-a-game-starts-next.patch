From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: prospero-win <prospero-win@invalid>
Date: Sun, 1 Nov 2026 12:00:00 +0100
Subject: [PATCH] ntdll: Run a program a game starts next on PS5.

A PS5 title is a single process, so a launcher that starts its game
fails ("Invalid handle" in a .NET launcher, error 50 elsewhere). Console
games that have several programs switch between them instead: the
running program ends and the system starts the next one as the same app
(sceSystemServiceLoadExec).

When the title names a request file in WINE_PS5_EXEC_CHAIN,
NtCreateUserProcess writes the program, its arguments and its working
directory there and returns handles to the caller's own process and
thread with only query and wait rights, so a launcher that starts its
game and exits carries on as on Windows. The title then runs the program
in the same prefix once the session has ended. Only the first program of
a session is recorded; threads that start programs at the same time are
serialized. A suspended start is accepted and the thread handle may resume
(a no-op on a running thread), as The Witcher 3's REDprelauncher starts
its game suspended. Programs under C:\windows, anything that is not an
.exe and fields longer than the title accepts are still refused.
---
 dlls/ntdll/unix/process.c | 163 ++++++++++++++++++++++++++++++++++++-
 1 file changed, 162 insertions(+), 1 deletion(-)

diff --git a/dlls/ntdll/unix/process.c b/dlls/ntdll/unix/process.c
index 1b2e7a6..da4f8ac 100644
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -682,6 +682,164 @@ static NTSTATUS alloc_handle_list( const PS_ATTRIBUTE *handles_attr, obj_handle_
 /**********************************************************************
  *           NtCreateUserProcess  (NTDLL.@)
  */
+#ifdef __PROSPERO__
+/* A PS5 title is a single process: it can neither fork nor exec. When the
+ * title names a request file in WINE_PS5_EXEC_CHAIN, the first program a game
+ * starts is written there instead, and the title runs it next, in the same
+ * prefix, once this one has ended (sceSystemServiceLoadExec, as console games
+ * switch programs). The caller gets handles to its own process and thread with
+ * only query and wait rights, so a launcher that starts its game and exits
+ * carries on as on Windows; one that waits for the program waits forever.
+ * A suspended start is accepted too (The Witcher 3's REDprelauncher starts its
+ * game suspended): the thread handle may also resume, which does nothing to a
+ * thread that is not suspended, so the caller's ResumeThread succeeds.
+ * Programs under C:\windows (debuggers, rundll32, start.exe), anything that
+ * is not an .exe and fields longer than the title accepts are still refused. */
+enum { PS5_CHAIN_PATH_MAX = 259, PS5_CHAIN_ARGS_MAX = 512 };  /* bytes, without the NUL */
+
+static pthread_mutex_t ps5_chain_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static int ps5_chain_put( int fd, const char *key, const WCHAR *str, DWORD len, int max )
+{
+    char buf[3 * 1024];
+    int n, i;
+
+    if (len > 1024) return -1;
+    n = len ? ntdll_wcstoumbs( str, len, buf, sizeof(buf), FALSE ) : 0;
+    if (n < 0 || n > max) return -1;
+    for (i = 0; i < n; i++) if (buf[i] == '\n' || buf[i] == '\r' || !buf[i]) return -1;
+    if (write( fd, key, strlen(key) ) != (ssize_t)strlen(key)) return -1;
+    if (n && write( fd, buf, n ) != n) return -1;
+    if (write( fd, "\n", 1 ) != 1) return -1;
+    return 0;
+}
+
+/* Write the request; 0 when it is in place. Called with ps5_chain_mutex held. */
+static int ps5_chain_write( const char *request, const char *temp, const UNICODE_STRING *image,
+                            const WCHAR *args, DWORD args_len, const UNICODE_STRING *cwd )
+{
+    int fd, failed;
+
+    if (!access( request, F_OK ))
+    {
+        MESSAGE( "wine: PS5 exec chain refused %s (a program is already queued)\n", debugstr_us( image ) );
+        return -1;
+    }
+    unlink( temp );  /* left by a write that failed half-way */
+    if ((fd = open( temp, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600 )) == -1)
+    {
+        MESSAGE( "wine: PS5 exec chain cannot write %s (errno %d)\n", temp, errno );
+        return -1;
+    }
+    failed = write( fd, "pw-exec-chain 1\n", 16 ) != 16 ||
+             ps5_chain_put( fd, "image=", image->Buffer, image->Length / sizeof(WCHAR), PS5_CHAIN_PATH_MAX ) ||
+             ps5_chain_put( fd, "args=", args, args_len, PS5_CHAIN_ARGS_MAX ) ||
+             ps5_chain_put( fd, "cwd=", cwd->Buffer, cwd->Length / sizeof(WCHAR), PS5_CHAIN_PATH_MAX ) ||
+             fsync( fd );
+    if (close( fd )) failed = 1;
+    if (!failed && !rename( temp, request )) return 0;
+    MESSAGE( "wine: PS5 exec chain refused %s (cannot write the request, or a field is too long)\n",
+             debugstr_us( image ) );
+    unlink( temp );
+    return -1;
+}
+
+static NTSTATUS ps5_exec_chain( HANDLE *process_handle_ptr, HANDLE *thread_handle_ptr,
+                                const RTL_USER_PROCESS_PARAMETERS *params, PS_ATTRIBUTE_LIST *ps_attr )
+{
+    static const WCHAR windir[] = {'c',':','\\','w','i','n','d','o','w','s','\\'};
+    static const WCHAR exe[] = {'.','e','x','e'};
+    const char *request = getenv( "WINE_PS5_EXEC_CHAIN" );
+    const WCHAR *image = params->ImagePathName.Buffer, *args = params->CommandLine.Buffer;
+    DWORD image_len = params->ImagePathName.Length / sizeof(WCHAR);
+    DWORD args_len = params->CommandLine.Length / sizeof(WCHAR);
+    SIZE_T i, attr_count = (ps_attr->TotalLength - sizeof(ps_attr->TotalLength)) / sizeof(PS_ATTRIBUTE);
+    HANDLE process = 0, thread = 0;
+    char temp[1024];
+    NTSTATUS status;
+    BOOL quoted = FALSE;
+
+    if (!request || !*request || strlen( request ) + 5 > sizeof(temp)) return STATUS_NOT_SUPPORTED;
+    if (!image || image_len <= ARRAY_SIZE(exe)) return STATUS_NOT_SUPPORTED;
+    for (i = 0; i < ARRAY_SIZE(exe); i++)
+        if (towlower( image[image_len - ARRAY_SIZE(exe) + i] ) != exe[i]) return STATUS_NOT_SUPPORTED;
+    if (image_len > ARRAY_SIZE(windir))
+    {
+        for (i = 0; i < ARRAY_SIZE(windir); i++) if (towlower( image[i] ) != windir[i]) break;
+        if (i == ARRAY_SIZE(windir))
+        {
+            MESSAGE( "wine: PS5 exec chain refused %s (Windows program)\n", debugstr_us( &params->ImagePathName ) );
+            return STATUS_NOT_SUPPORTED;
+        }
+    }
+
+    /* The arguments: the command line without its first word (the program),
+     * split as the C runtime does: a quoted first word ends at its closing quote. */
+    for (i = 0; i < args_len; i++)
+    {
+        if (args[i] == '"') quoted = !quoted;
+        else if (!quoted && (args[i] == ' ' || args[i] == '\t')) break;
+    }
+    while (i < args_len && (args[i] == ' ' || args[i] == '\t')) i++;
+    args += i;
+    args_len -= i;
+
+    /* One request per session: the first program started wins. The lock
+     * makes the check, the write and the handles one step for all threads. */
+    snprintf( temp, sizeof(temp), "%s.tmp", request );
+    pthread_mutex_lock( &ps5_chain_mutex );
+    if (ps5_chain_write( request, temp, &params->ImagePathName, args, args_len,
+                         &params->CurrentDirectory.DosPath ))
+    {
+        pthread_mutex_unlock( &ps5_chain_mutex );
+        return STATUS_NOT_SUPPORTED;
+    }
+    status = NtDuplicateObject( NtCurrentProcess(), NtCurrentProcess(), NtCurrentProcess(), &process,
+                                SYNCHRONIZE | PROCESS_QUERY_LIMITED_INFORMATION, 0, 0 );
+    if (!status)
+        status = NtDuplicateObject( NtCurrentProcess(), NtCurrentThread(), NtCurrentProcess(), &thread,
+                                    SYNCHRONIZE | THREAD_QUERY_LIMITED_INFORMATION | THREAD_SUSPEND_RESUME, 0, 0 );
+    if (status)
+    {
+        MESSAGE( "wine: PS5 exec chain cannot make placeholder handles (status %#x)\n", (int)status );
+        if (process) NtClose( process );
+        unlink( request );
+        pthread_mutex_unlock( &ps5_chain_mutex );
+        return STATUS_NOT_SUPPORTED;
+    }
+    pthread_mutex_unlock( &ps5_chain_mutex );
+
+    for (i = 0; i < attr_count; i++)
+    {
+        switch (ps_attr->Attributes[i].Attribute)
+        {
+        case PS_ATTRIBUTE_CLIENT_ID:
+        {
+            CLIENT_ID id = NtCurrentTeb()->ClientId;
+            SIZE_T size = min( ps_attr->Attributes[i].Size, sizeof(id) );
+            memcpy( ps_attr->Attributes[i].ValuePtr, &id, size );
+            if (ps_attr->Attributes[i].ReturnLength) *ps_attr->Attributes[i].ReturnLength = size;
+            break;
+        }
+        case PS_ATTRIBUTE_IMAGE_INFO:
+        {
+            SIZE_T size = min( ps_attr->Attributes[i].Size, sizeof(SECTION_IMAGE_INFORMATION) );
+            memset( ps_attr->Attributes[i].ValuePtr, 0, size );
+            if (ps_attr->Attributes[i].ReturnLength) *ps_attr->Attributes[i].ReturnLength = size;
+            break;
+        }
+        default:
+            break;
+        }
+    }
+    *process_handle_ptr = process;
+    *thread_handle_ptr = thread;
+    MESSAGE( "wine: PS5 exec chain queued %s args %s cwd %s\n", debugstr_us( &params->ImagePathName ),
+             debugstr_wn( args, args_len ), debugstr_us( &params->CurrentDirectory.DosPath ) );
+    return STATUS_SUCCESS;
+}
+#endif
+
 NTSTATUS WINAPI NtCreateUserProcess( HANDLE *process_handle_ptr, HANDLE *thread_handle_ptr,
                                      ACCESS_MASK process_access, ACCESS_MASK thread_access,
                                      OBJECT_ATTRIBUTES *process_attr, OBJECT_ATTRIBUTES *thread_attr,
@@ -712,7 +870,10 @@ NTSTATUS WINAPI NtCreateUserProcess( HANDLE *process_handle_ptr, HANDLE *thread_
 
 #ifdef __PROSPERO__
     /* A PS5 title is a single process: it can neither fork nor exec, so
-     * Windows process creation fails cleanly instead of spawning a loader. */
+     * Windows process creation fails cleanly instead of spawning a loader,
+     * unless the title runs the program next (ps5_exec_chain). */
+    if (!(status = ps5_exec_chain( process_handle_ptr, thread_handle_ptr, params, ps_attr )))
+        return STATUS_SUCCESS;
     TRACE( "process creation is not supported on PS5\n" );
     return STATUS_NOT_SUPPORTED;
 #endif
