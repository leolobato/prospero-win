From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: prospero-win <prospero-win@invalid>
Date: Mon, 9 Nov 2026 18:00:00 +0100
Subject: [PATCH] ntdll: Let the PS5 title show notifications and ask about invites.

Code inside the game (an online bridge) wants to tell the player
something while the game runs, and to ask whether to accept an invite.
The game's image fills the screen, so the title shows the text as a
system notification, and it reads the answer from the DualSense:
L3+R3 pressed together accepts.

Two private process information classes reach the title through the
sink that ntdll.prx links (wine/ps5/pw_wine_sink.c), with pointer-free
structs that have one layout for PE32, PE64 and the Unix side
(wine/ps5/menu/pw_title_notify.h):

- ProcessWineTitleNotify (0x50574D02), set: struct pw_title_notify,
  UTF-8 text up to 1023 bytes, shown by the title.
- ProcessWineTitleInvite (0x50574D03), set: struct pw_title_invite
  with the milliseconds the player has, or 0 to forget the question;
  query: its answer, none (still open, or none asked), accepted or
  expired, reported once.

Both act on the current process only. Without a title that takes them
(a PC, an older title) they fail with STATUS_NOT_SUPPORTED, and the
caller logs the text and answers for the player. The sink measures the
deadline on CLOCK_MONOTONIC, as the title does. WoW64 passes both
through as it does the menu (patch 0973), and the invite query, polled
while a question is open, is not traced (patch 0970).
---
 dlls/ntdll/unix/process.c | 87 +++++++++++++++++++++++++++++++++++++++++++++++
 dlls/wow64/process.c      |  6 ++++
 include/winternl.h        |  2 ++
 3 files changed, 95 insertions(+)

diff --git a/dlls/ntdll/unix/process.c b/dlls/ntdll/unix/process.c
index c99ce10..3cac9fa 100644
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -1404,6 +1404,73 @@ static NTSTATUS title_menu( struct pw_title_menu *menu )
 #endif
 }
 
+#include "../pw_title_notify.h"
+
+#ifdef __PROSPERO__
+/* wine/ps5/pw_wine_sink.c: the title's notifications and its invite
+ * question. Deadlines are CLOCK_MONOTONIC milliseconds on both sides. */
+extern int pw_wine_notify( const char *text );
+extern int pw_wine_invite_ask( uint32_t timeout_ms, uint64_t now_ms );
+extern int pw_wine_invite_answer( uint64_t now_ms );
+
+static uint64_t title_now_ms(void)
+{
+    struct timespec now;
+
+    if (clock_gettime( CLOCK_MONOTONIC, &now )) return 0;
+    return (uint64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+#endif
+
+/* Code in the game asks the title to show a system notification. Without a
+ * title (a PC), or a title that does not take them, the call fails and the
+ * caller logs the text instead. */
+static NTSTATUS title_notify( const struct pw_title_notify *notify )
+{
+    if (notify->version != PW_TITLE_NOTIFY_VERSION) return STATUS_INVALID_PARAMETER;
+    if (!memchr( notify->text, 0, sizeof(notify->text) )) return STATUS_INVALID_PARAMETER;
+#ifdef __PROSPERO__
+    switch (pw_wine_notify( notify->text ))
+    {
+    case 0: return STATUS_SUCCESS;
+    case -1: return STATUS_NOT_SUPPORTED;     /* no sink */
+    default: return STATUS_UNSUCCESSFUL;      /* the title did not show it */
+    }
+#else
+    return STATUS_NOT_SUPPORTED;
+#endif
+}
+
+/* An invite question the player answers with L3+R3 on the title's
+ * controller: asked (or forgotten, with no time) by a set, its answer read
+ * by a query. Without a title that takes questions both fail, and the
+ * caller answers for the player. */
+static NTSTATUS title_invite_ask( const struct pw_title_invite *invite )
+{
+    if (invite->version != PW_TITLE_NOTIFY_VERSION) return STATUS_INVALID_PARAMETER;
+#ifdef __PROSPERO__
+    if (pw_wine_invite_ask( invite->timeout_ms, title_now_ms() )) return STATUS_NOT_SUPPORTED;
+    return STATUS_SUCCESS;
+#else
+    return STATUS_NOT_SUPPORTED;
+#endif
+}
+
+static NTSTATUS title_invite_answer( struct pw_title_invite *invite )
+{
+#ifdef __PROSPERO__
+    int answer = pw_wine_invite_answer( title_now_ms() );
+
+    if (answer < 0) return STATUS_NOT_SUPPORTED;
+    memset( invite, 0, sizeof(*invite) );
+    invite->version = PW_TITLE_NOTIFY_VERSION;
+    invite->answer = answer;
+    return STATUS_SUCCESS;
+#else
+    return STATUS_NOT_SUPPORTED;
+#endif
+}
+
 #ifdef __PROSPERO__
 /* Games poll some classes every frame: Call of Juarez Gunslinger asks for
  * ProcessAffinityMask 60 times a second, and with the title's +process
@@ -1415,6 +1482,7 @@ static BOOL first_query( PROCESSINFOCLASS class )
     unsigned int bit;
 
     if (class == PW_TITLE_MENU_PROCESS_INFO) return FALSE;  /* every frame, by design */
+    if (class == PW_TITLE_INVITE_PROCESS_INFO) return FALSE;  /* polled while a question is open */
     if ((unsigned int)class >= 32 * ARRAY_SIZE(queried)) return TRUE;
     bit = 1u << (class % 32);
     return !(__atomic_fetch_or( &queried[class / 32], bit, __ATOMIC_RELAXED ) & bit);
@@ -1448,6 +1516,13 @@ NTSTATUS WINAPI NtQueryInformationProcess( HANDLE handle, PROCESSINFOCLASS class
         else if (!info) ret = STATUS_ACCESS_VIOLATION;
         else ret = title_menu( info );
         break;
+    case PW_TITLE_INVITE_PROCESS_INFO:
+        len = sizeof(struct pw_title_invite);
+        if (handle != NtCurrentProcess()) ret = STATUS_INVALID_HANDLE;
+        else if (size != len) ret = STATUS_INFO_LENGTH_MISMATCH;
+        else if (!info) ret = STATUS_ACCESS_VIOLATION;
+        else ret = title_invite_answer( info );
+        break;
     UNIMPLEMENTED_INFO_CLASS(ProcessBasePriority);
     UNIMPLEMENTED_INFO_CLASS(ProcessRaisePriority);
     UNIMPLEMENTED_INFO_CLASS(ProcessExceptionPort);
@@ -2223,6 +2298,18 @@ NTSTATUS WINAPI NtSetInformationProcess( HANDLE handle, PROCESSINFOCLASS class,
         FIXME( "ProcessPowerThrottlingState - stub\n" );
         return STATUS_SUCCESS;
 
+    case PW_TITLE_NOTIFY_PROCESS_INFO:
+        if (handle != NtCurrentProcess()) return STATUS_INVALID_HANDLE;
+        if (size != sizeof(struct pw_title_notify)) return STATUS_INFO_LENGTH_MISMATCH;
+        if (!info) return STATUS_ACCESS_VIOLATION;
+        return title_notify( info );
+
+    case PW_TITLE_INVITE_PROCESS_INFO:
+        if (handle != NtCurrentProcess()) return STATUS_INVALID_HANDLE;
+        if (size != sizeof(struct pw_title_invite)) return STATUS_INFO_LENGTH_MISMATCH;
+        if (!info) return STATUS_ACCESS_VIOLATION;
+        return title_invite_ask( info );
+
     default:
         FIXME( "(%p,0x%08x,%p,0x%08x) stub\n", handle, class, info, size );
         ret = STATUS_NOT_IMPLEMENTED;
diff --git a/dlls/wow64/process.c b/dlls/wow64/process.c
index 28cc751..d482c04 100644
--- a/dlls/wow64/process.c
+++ b/dlls/wow64/process.c
@@ -29,6 +29,7 @@
 #include "wow64_private.h"
 #include "../ntdll/pw_qpc_clock.h"
 #include "../ntdll/pw_title_menu.h"
+#include "../ntdll/pw_title_notify.h"
 #include "wine/asm.h"
 #include "wine/exception.h"
 #include "wine/debug.h"
@@ -591,6 +592,9 @@ NTSTATUS WINAPI wow64_NtQueryInformationProcess( UINT *args )
     case PW_TITLE_MENU_PROCESS_INFO:
         /* The same: pointer-free, one layout for PE32 and the Unix side. */
         return NtQueryInformationProcess( handle, class, ptr, len, retlen );
+    case PW_TITLE_INVITE_PROCESS_INFO:
+        /* The same. */
+        return NtQueryInformationProcess( handle, class, ptr, len, retlen );
     case ProcessBasicInformation:  /* PROCESS_BASIC_INFORMATION */
         if (len == sizeof(PROCESS_BASIC_INFORMATION32))
         {
@@ -954,6 +958,8 @@ NTSTATUS WINAPI wow64_NtSetInformationProcess( UINT *args )
     case ProcessPowerThrottlingState:   /* PROCESS_POWER_THROTTLING_STATE */
     case ProcessLeapSecondInformation:   /* PROCESS_LEAP_SECOND_INFO */
     case ProcessWineGrantAdminToken:   /* NULL */
+    case PW_TITLE_NOTIFY_PROCESS_INFO:   /* struct pw_title_notify, pointer-free */
+    case PW_TITLE_INVITE_PROCESS_INFO:   /* struct pw_title_invite, pointer-free */
         return NtSetInformationProcess( handle, class, ptr, len );
 
     case ProcessExecuteFlags:   /* ULONG */
diff --git a/include/winternl.h b/include/winternl.h
index 28b52fe..3f85eb9 100644
--- a/include/winternl.h
+++ b/include/winternl.h
@@ -2015,6 +2015,8 @@ typedef enum _PROCESSINFOCLASS {
     ProcessWineGrantAdminToken = 1002,
     ProcessWineQpcAnchor = 0x50575101,
     ProcessWineTitleMenu = 0x50574D01,
+    ProcessWineTitleNotify = 0x50574D02,
+    ProcessWineTitleInvite = 0x50574D03,
 #endif
 } PROCESSINFOCLASS;
 
