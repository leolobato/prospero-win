+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <dlfcn.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "ddk/hidtypes.h"
+
+#include "wine/debug.h"
+
+#include "unix_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(hid);
+
+/* A PS5 title keeps its DualSense's state, in XINPUT_GAMEPAD terms, in its
+ * sink (wine/ps5/pw_wine_sink.h), whose calls ntdll exports; anywhere else
+ * they are missing and this bus does not start. It has one device, always
+ * present: an Xbox 360 controller, so that the HID stack gives it the &IG_
+ * gamepad interface and its winexinput &XI_ partner, which DirectInput,
+ * winmm, Raw Input and Windows.Gaming.Input find. A disconnected pad
+ * reports a neutral state. XInput itself reads the sink directly (patch
+ * 0470) and does not use this device. */
+struct title_pad_state
+{
+    UINT32 connected;
+    UINT32 packet;
+    UINT16 buttons;
+    UINT8 left_trigger, right_trigger;
+    INT16 thumb_lx, thumb_ly, thumb_rx, thumb_ry;
+};
+
+static int (*title_pad)(struct title_pad_state *state);
+static void (*title_rumble)(UINT32 left, UINT32 right);
+
+/* How often the pad is read: the title updates it once per frame or so. */
+#define PS5_POLL_NS (4 * 1000 * 1000)
+
+static pthread_mutex_t ps5_cs = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t ps5_wake = PTHREAD_COND_INITIALIZER;
+static BOOL ps5_stopping;
+static struct list event_queue = LIST_INIT(event_queue);
+
+struct ps5_device
+{
+    struct unix_device unix_device;
+    BOOL started;
+    BOOL have_state;
+    struct title_pad_state last;
+    UINT64 rumble_until;  /* CLOCK_MONOTONIC ns when the rumble stops; 0: until told */
+};
+
+static struct ps5_device *ps5_pad;
+
+static inline struct ps5_device *impl_from_unix_device(struct unix_device *iface)
+{
+    return CONTAINING_RECORD(iface, struct ps5_device, unix_device);
+}
+
+static UINT64 monotonic_ns(void)
+{
+    struct timespec now;
+
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return (UINT64)now.tv_sec * 1000000000 + now.tv_nsec;
+}
+
+static void ps5_device_destroy(struct unix_device *iface)
+{
+}
+
+static NTSTATUS ps5_device_start(struct unix_device *iface)
+{
+    struct ps5_device *impl = impl_from_unix_device(iface);
+
+    pthread_mutex_lock(&ps5_cs);
+    impl->started = TRUE;
+    impl->have_state = FALSE;
+    pthread_mutex_unlock(&ps5_cs);
+    return STATUS_SUCCESS;
+}
+
+static void ps5_device_stop(struct unix_device *iface)
+{
+    struct ps5_device *impl = impl_from_unix_device(iface);
+
+    pthread_mutex_lock(&ps5_cs);
+    impl->started = FALSE;
+    impl->rumble_until = 0;
+    if (ps5_pad == impl) ps5_pad = NULL;
+    if (title_rumble) title_rumble(0, 0);
+    pthread_mutex_unlock(&ps5_cs);
+}
+
+static NTSTATUS ps5_device_haptics_start(struct unix_device *iface, UINT duration_ms,
+                                         USHORT rumble_intensity, USHORT buzz_intensity,
+                                         USHORT left_intensity, USHORT right_intensity)
+{
+    struct ps5_device *impl = impl_from_unix_device(iface);
+
+    TRACE("iface %p, duration_ms %u, rumble_intensity %u, buzz_intensity %u.\n",
+          iface, duration_ms, rumble_intensity, buzz_intensity);
+
+    /* The low-frequency motor is on the left, as on an Xbox controller. The
+     * title's motors keep their levels, so the bus loop stops them when the
+     * duration (the HID report's cutoff) runs out; 0 has none, as in SDL. */
+    if (!title_rumble) return STATUS_NOT_SUPPORTED;
+    pthread_mutex_lock(&ps5_cs);
+    impl->rumble_until = duration_ms && (rumble_intensity || buzz_intensity)
+                         ? monotonic_ns() + (UINT64)duration_ms * 1000000 : 0;
+    title_rumble(rumble_intensity, buzz_intensity);
+    pthread_mutex_unlock(&ps5_cs);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS ps5_device_haptics_stop(struct unix_device *iface)
+{
+    struct ps5_device *impl = impl_from_unix_device(iface);
+
+    if (!title_rumble) return STATUS_NOT_SUPPORTED;
+    pthread_mutex_lock(&ps5_cs);
+    impl->rumble_until = 0;
+    title_rumble(0, 0);
+    pthread_mutex_unlock(&ps5_cs);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS ps5_device_physical_device_control(struct unix_device *iface, USAGE control)
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS ps5_device_physical_device_set_gain(struct unix_device *iface, BYTE percent)
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS ps5_device_physical_effect_control(struct unix_device *iface, BYTE index,
+                                                   USAGE control, BYTE iterations)
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS ps5_device_physical_effect_update(struct unix_device *iface, BYTE index,
+                                                  struct effect_params *params)
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+static const struct hid_device_vtbl ps5_device_vtbl =
+{
+    ps5_device_destroy,
+    ps5_device_start,
+    ps5_device_stop,
+    ps5_device_haptics_start,
+    ps5_device_haptics_stop,
+    ps5_device_physical_device_control,
+    ps5_device_physical_device_set_gain,
+    ps5_device_physical_effect_control,
+    ps5_device_physical_effect_update,
+};
+
+/* XINPUT_GAMEPAD buttons, in the order hid_device_add_gamepad lays them out
+ * (the SDL bus's controller mapping). */
+static const struct { UINT16 mask; BYTE button; } ps5_buttons[] =
+{
+    {0x1000, 0},  /* A */
+    {0x2000, 1},  /* B */
+    {0x4000, 2},  /* X */
+    {0x8000, 3},  /* Y */
+    {0x0100, 4},  /* left shoulder */
+    {0x0200, 5},  /* right shoulder */
+    {0x0020, 6},  /* back */
+    {0x0010, 7},  /* start */
+    {0x0040, 8},  /* left stick */
+    {0x0080, 9},  /* right stick */
+    {0x0001, 10}, /* d-pad up */
+    {0x0008, 11}, /* d-pad right */
+    {0x0002, 12}, /* d-pad down */
+    {0x0004, 13}, /* d-pad left */
+    {0x0400, 16}, /* guide */
+};
+
+static void set_report_from_state(struct unix_device *iface, const struct title_pad_state *state)
+{
+    UINT16 buttons = state->buttons;
+    unsigned int i;
+
+    /* Thumb Y grows upwards in XInput, as in the XUSB report the gamepad
+     * layout follows. */
+    hid_device_set_abs_axis(iface, 0, state->thumb_lx);
+    hid_device_set_abs_axis(iface, 1, state->thumb_ly);
+    hid_device_set_abs_axis(iface, 2, state->thumb_rx);
+    hid_device_set_abs_axis(iface, 3, state->thumb_ry);
+    hid_device_set_abs_axis(iface, 4, state->left_trigger * 32767 / 255);
+    hid_device_set_abs_axis(iface, 5, state->right_trigger * 32767 / 255);
+
+    hid_device_set_hatswitch_x(iface, 0, (buttons & 0x0008 ? 1 : 0) - (buttons & 0x0004 ? 1 : 0));
+    hid_device_set_hatswitch_y(iface, 0, (buttons & 0x0002 ? 1 : 0) - (buttons & 0x0001 ? 1 : 0));
+    for (i = 0; i < ARRAY_SIZE(ps5_buttons); i++)
+        hid_device_set_button(iface, ps5_buttons[i].button, !!(buttons & ps5_buttons[i].mask));
+}
+
+/* Stops a rumble whose duration ran out, reads the pad and queues a report
+ * when it changed. Called with ps5_cs. */
+static void ps5_poll(void)
+{
+    struct ps5_device *impl = ps5_pad;
+    struct unix_device *iface;
+    struct title_pad_state state;
+
+    if (!impl || !impl->started) return;
+    iface = &impl->unix_device;
+    if (impl->rumble_until && monotonic_ns() >= impl->rumble_until)
+    {
+        impl->rumble_until = 0;
+        title_rumble(0, 0);
+    }
+    if (!title_pad(&state)) memset(&state, 0, sizeof(state));
+    if (impl->have_state && !memcmp(&state, &impl->last, sizeof(state))) return;
+    impl->last = state;
+    impl->have_state = TRUE;
+
+    set_report_from_state(iface, &state);
+    bus_event_queue_input_report(&event_queue, iface, iface->hid_device_state.report_buf,
+                                 iface->hid_device_state.report_len);
+}
+
+NTSTATUS ps5_bus_init(void *args)
+{
+    static const USAGE_AND_PAGE device_usage = {.UsagePage = HID_USAGE_PAGE_GENERIC, .Usage = HID_USAGE_GENERIC_GAMEPAD};
+    static const struct title_pad_state neutral;
+    struct device_desc desc =
+    {
+        .vid = 0x045e,
+        .pid = 0x028e,
+        .version = 0x0114,
+        .input = -1,
+        .bus_id = -1,
+        .bus_type = BUS_TYPE_USB,
+        .is_gamepad = TRUE,
+        .manufacturer = {'M','i','c','r','o','s','o','f','t',0},
+        .product = {'C','o','n','t','r','o','l','l','e','r',' ','(','X','B','O','X',' ','3','6','0',' ',
+                    'F','o','r',' ','W','i','n','d','o','w','s',')',0},
+        .serialnumber = {'0','0','0','0',0},
+    };
+    struct unix_device *iface;
+    struct ps5_device *impl;
+
+    title_pad = dlsym(RTLD_DEFAULT, "pw_wine_pad");
+    title_rumble = dlsym(RTLD_DEFAULT, "pw_wine_set_rumble");
+    if (!title_pad) return STATUS_NOT_SUPPORTED;
+    TRACE("found the title's controller\n");
+
+    if (!(impl = hid_device_create(&ps5_device_vtbl, sizeof(struct ps5_device)))) return STATUS_NO_MEMORY;
+    iface = &impl->unix_device;
+    if (!hid_device_begin_report_descriptor(iface, &device_usage)) goto failed;
+    if (!hid_device_add_gamepad(iface)) goto failed;
+    if (title_rumble && !hid_device_add_haptics(iface)) goto failed;
+    if (!hid_device_end_report_descriptor(iface)) goto failed;
+    set_report_from_state(iface, &neutral);
+
+    pthread_mutex_lock(&ps5_cs);
+    ps5_stopping = FALSE;
+    ps5_pad = impl;
+    bus_event_queue_device_created(&event_queue, iface, &desc);
+    pthread_mutex_unlock(&ps5_cs);
+    return STATUS_SUCCESS;
+
+failed:
+    free(iface->hid_report_descriptor.data);
+    free(impl);
+    return STATUS_NO_MEMORY;
+}
+
+NTSTATUS ps5_bus_wait(void *args)
+{
+    struct bus_event *result = args;
+    struct timespec deadline;
+
+    /* cleanup previously returned event */
+    bus_event_cleanup(result);
+
+    pthread_mutex_lock(&ps5_cs);
+    while (!ps5_stopping)
+    {
+        if (bus_event_queue_pop(&event_queue, result))
+        {
+            pthread_mutex_unlock(&ps5_cs);
+            return STATUS_PENDING;
+        }
+
+        clock_gettime(CLOCK_REALTIME, &deadline);
+        deadline.tv_nsec += PS5_POLL_NS;
+        if (deadline.tv_nsec >= 1000000000)
+        {
+            deadline.tv_sec++;
+            deadline.tv_nsec -= 1000000000;
+        }
+        pthread_cond_timedwait(&ps5_wake, &ps5_cs, &deadline);
+        if (!ps5_stopping) ps5_poll();
+    }
+
+    TRACE("PS5 main loop exiting\n");
+    bus_event_queue_destroy(&event_queue);
+    pthread_mutex_unlock(&ps5_cs);
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS ps5_bus_stop(void *args)
+{
+    pthread_mutex_lock(&ps5_cs);
+    ps5_stopping = TRUE;
+    pthread_cond_signal(&ps5_wake);
+    pthread_mutex_unlock(&ps5_cs);
+    return STATUS_SUCCESS;
+}
diff --git a/dlls/winebus.sys/main.c b/dlls/winebus.sys/main.c
index e3877ca..649f64f 100644
--- a/dlls/winebus.sys/main.c
+++ b/dlls/winebus.sys/main.c
@@ -1301,6 +1301,19 @@ static NTSTATUS iohid_driver_init(void)
     return bus_main_thread_start(&bus);
 }
 
+/* A PS5 title's controller (bus_ps5.c); it starts only inside a title. */
+static NTSTATUS ps5_driver_init(void)
+{
+    struct bus_main_params bus =
+    {
+        .name = L"PS5",
+        .init_args = &options,
+        .init_code = ps5_init,
+        .wait_code = ps5_wait,
+    };
+    return bus_main_thread_start(&bus);
+}
+
 static NTSTATUS fdo_pnp_dispatch(DEVICE_OBJECT *device, IRP *irp)
 {
     IO_STACK_LOCATION *irpsp = IoGetCurrentIrpStackLocation(irp);
@@ -1314,6 +1327,14 @@ static NTSTATUS fdo_pnp_dispatch(DEVICE_OBJECT *device, IRP *irp)
     case IRP_MN_START_DEVICE:
         bus_options_init();
 
+        /* A PS5 title has no other input devices: its keyboard and mouse
+         * reach Wine through the user driver, not HID. */
+        if (!ps5_driver_init())
+        {
+            irp->IoStatus.Status = STATUS_SUCCESS;
+            break;
+        }
+
         mouse_device_create();
         keyboard_device_create();
 
@@ -1330,6 +1351,7 @@ static NTSTATUS fdo_pnp_dispatch(DEVICE_OBJECT *device, IRP *irp)
         winebus_call(sdl_stop, NULL);
         winebus_call(udev_stop, NULL);
         winebus_call(iohid_stop, NULL);
+        winebus_call(ps5_stop, NULL);
 
         WaitForMultipleObjects(bus_count, bus_thread, TRUE, INFINITE);
         while (bus_count--) CloseHandle(bus_thread[bus_count]);
diff --git a/dlls/winebus.sys/unix_private.h b/dlls/winebus.sys/unix_private.h
index c39c878..66df2e1 100644
--- a/dlls/winebus.sys/unix_private.h
