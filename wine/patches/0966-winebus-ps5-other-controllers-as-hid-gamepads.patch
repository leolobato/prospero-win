+/* Reads the controllers and makes or removes the other users' devices. Called
+ * with ps5_cs. */
+static void ps5_poll(void)
+{
+    struct title_pad_state state;
+    UINT32 slot;
+
+    if (ps5_pad && ps5_pad->started)
+    {
+        if (!title_pad(&state)) memset(&state, 0, sizeof(state));
+        ps5_device_poll(ps5_pad, &state);
+    }
+
+    if (title_pad_peek && title_rumble_at)
+    {
+        for (slot = 1; slot < PS5_SLOTS; slot++)
+        {
+            BOOL connected = title_pad_peek(slot, &state) != 0;
+            struct ps5_device *impl = ps5_slots[slot].device;
+
+            switch (ps5_slot_step(&ps5_slots[slot].state, connected))
+            {
+            case PS5_SLOT_CREATE:
+                if (!(ps5_slots[slot].device = ps5_device_create(slot)))
+                {
+                    WARN("no device for controller %u\n", slot);
+                    ps5_slots[slot].state = PS5_SLOT_ABSENT;
+                }
+                break;
+            case PS5_SLOT_REMOVE:
+                if (!bus_event_queue_device_removed(&event_queue, &impl->unix_device))
+                {
+                    /* It stays until a later poll can ask again. */
+                    ps5_slots[slot].state = PS5_SLOT_PRESENT;
+                }
+                else title_rumble_at(slot, 0, 0);
+                break;
+            case PS5_SLOT_NONE:
+                if (connected && impl && impl->started) ps5_device_poll(impl, &state);
+                break;
+            }
+        }
+    }
+
+    if (title_pad_notify && ps5_notice_first && monotonic_ns() >= ps5_notice_first)
+    {
+        title_pad_notify();
+        ps5_notice_first = 0;
+    }
+    if (title_pad_notify && ps5_notice_last && monotonic_ns() >= ps5_notice_last)
+    {
+        title_pad_notify();
+        ps5_notice_last = 0;
+    }
+}
