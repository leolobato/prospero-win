--- a/dlls/hidclass.sys/device.c
+++ b/dlls/hidclass.sys/device.c
@@ -749,7 +749,8 @@ NTSTATUS WINAPI pdo_create( DEVICE_OBJECT *device, IRP *irp )
 {
     struct phys_device *pdo = pdo_from_DEVICE_OBJECT( device );
     struct hid_queue *queue;
-    BOOL removed;
+    BOOL removed, activate;
+    IO_STATUS_BLOCK io;
     KIRQL irql;
 
     TRACE("Open handle on device %p\n", device);
@@ -770,8 +771,13 @@ NTSTATUS WINAPI pdo_create( DEVICE_OBJECT *device, IRP *irp )
     {
         KeAcquireSpinLock( &pdo->lock, &irql );
         list_add_tail( &pdo->queues, &queue->entry );
+        activate = !pdo->activated;
+        pdo->activated = TRUE;
