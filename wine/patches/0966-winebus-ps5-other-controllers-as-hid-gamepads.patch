+/* Called with ps5_cs. */
+static void ps5_notice_later(void)
+{
+    UINT64 now = monotonic_ns();
+
+    ps5_notice_first = now + PS5_NOTICE_FIRST_NS;
+    ps5_notice_last = now + PS5_NOTICE_LAST_NS;
+}
+
+/* Called with ps5_cs. */
+static void ps5_rumble(struct ps5_device *impl, UINT32 left, UINT32 right)
+{
+    if (impl->slot) title_rumble_at(impl->slot, left, right);
+    else title_rumble(left, right);
+}
