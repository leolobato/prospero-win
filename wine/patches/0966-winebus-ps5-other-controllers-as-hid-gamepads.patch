+static LONG host_gamepads = 1;
+
 /* The &XI_ gamepad interface winexinput.sys makes for a HID gamepad. */
 static const GUID GUID_DEVINTERFACE_WINEXINPUT = {0x6c53d5fd, 0x6480, 0x440f, {0xb6, 0x18, 0x47, 0x67, 0x50, 0xc5, 0xe1, 0xa6}};
 
 void hosted_interface_enabled( const GUID *interface_class )
 {
-    if (host_gamepad && IsEqualGUID( interface_class, &GUID_DEVINTERFACE_WINEXINPUT )) SetEvent( host_gamepad );
+    if (host_gamepad && IsEqualGUID( interface_class, &GUID_DEVINTERFACE_WINEXINPUT ) &&
+        InterlockedDecrement( &host_gamepads ) <= 0)
+        SetEvent( host_gamepad );
 }
 
