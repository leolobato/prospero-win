 static struct ps5_device *ps5_pad;
 
+/* Controllers 1..3. A device that was asked to go is not replaced until it has
+ * stopped: until then a new one would have its instance ID. */
+#define PS5_SLOTS 4
+/* After a device comes or goes, when to tell the game's windows again: its
+ * interface appears some time after the device starts, and a title has no
+ * plugplay service to say so. */
+#define PS5_NOTICE_FIRST_NS (500ull * 1000 * 1000)
+#define PS5_NOTICE_LAST_NS (2000ull * 1000 * 1000)
+
+enum ps5_slot_state { PS5_SLOT_ABSENT, PS5_SLOT_PRESENT, PS5_SLOT_REMOVING };
+enum ps5_slot_action { PS5_SLOT_NONE, PS5_SLOT_CREATE, PS5_SLOT_REMOVE };
+
+static enum ps5_slot_action ps5_slot_step(enum ps5_slot_state *state, BOOL connected)
+{
+    switch (*state)
+    {
+    case PS5_SLOT_ABSENT:
+        if (!connected) return PS5_SLOT_NONE;
+        *state = PS5_SLOT_PRESENT;
+        return PS5_SLOT_CREATE;
+    case PS5_SLOT_PRESENT:
+        if (connected) return PS5_SLOT_NONE;
+        *state = PS5_SLOT_REMOVING;
+        return PS5_SLOT_REMOVE;
+    case PS5_SLOT_REMOVING:
+        return PS5_SLOT_NONE;
+    }
+    return PS5_SLOT_NONE;
+}
+
+static struct
+{
+    enum ps5_slot_state state;
+    struct ps5_device *device;
+} ps5_slots[PS5_SLOTS];
