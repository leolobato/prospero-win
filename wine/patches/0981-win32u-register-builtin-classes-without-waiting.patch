From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: prospero-win <prospero-win@invalid>
Date: Fri, 16 Oct 2026 09:10:25 +0200
Subject: [PATCH] win32u: Register the builtin classes without waiting on
 another thread.

register_builtin_classes() ran its body in a pthread_once, and the body
takes the loader lock: it loads the classes' cursors through a callback
into user32, and user32's part loads uxtheme.dll. A thread that held the
loader lock (in a DllMain) and created its first window waited in the
once for a thread that held the once and waited for the loader lock.

On the PS5 this hangs Source games at startup: vgui2.dll's static
initializer calls OleInitialize under the loader lock, while the hosted
PnP thread creates its COM apartment window during device install.

Now no thread waits: each one registers the classes still missing (one
that another thread registered first is looked up), and the first one
runs user32's part.
---
 dlls/win32u/class.c | 60 +++++++++++++++++++++++++++++++++++----------
 1 file changed, 47 insertions(+), 13 deletions(-)

diff --git a/dlls/win32u/class.c b/dlls/win32u/class.c
index 3ebef66..2b1cb43 100644
--- a/dlls/win32u/class.c
+++ b/dlls/win32u/class.c
@@ -1060,6 +1060,26 @@ ATOM get_builtin_class_atom( enum ntuser_client_procs proc )
     return builtin_classes[proc].atom;
 }
 
+/***********************************************************************
+ *           find_class_atom
+ *
+ * The atom of a registered class, without registering the builtin classes.
+ */
+static ATOM find_class_atom( HINSTANCE instance, UNICODE_STRING *name )
+{
+    struct object_lock lock = OBJECT_LOCK_INIT;
+    const class_shm_t *class_shm;
+    NTSTATUS status;
+    CLASS *class;
+    ATOM atom = 0;
+
+    if (!(class = find_class( instance, name ))) return 0;
+    while ((status = get_shared_class( class, &lock, &class_shm )) == STATUS_PENDING)
+        atom = class_shm->info.atom;
+    release_class_ptr( class );
+    return status ? 0 : atom;
+}
+
 /***********************************************************************
  *           register_builtin
  *
@@ -1071,6 +1091,7 @@ static void register_builtin( enum ntuser_client_procs proc )
     struct builtin_class_descr *descr = builtin_classes + proc;
     UNICODE_STRING name, version = { .Length = 0 };
     WCHAR nameW[64];
+    ATOM atom;
     WNDCLASSEXW class =
     {
         .cbSize = sizeof(class),
@@ -1089,31 +1110,44 @@ static void register_builtin( enum ntuser_client_procs proc )
     asciiz_to_unicode( nameW, descr->name );
     RtlInitUnicodeString( &name, nameW );
 
-    if ((descr->atom = NtUserRegisterClassExWOW( &class, &name, &version, NULL, MAKE_FNID(proc), 0, NULL ))) return;
+    if ((atom = NtUserRegisterClassExWOW( &class, &name, &version, NULL, MAKE_FNID(proc), 0, NULL )))
+    {
+        descr->atom = atom;
+        return;
+    }
     if (class.hCursor) NtUserDestroyCursor( class.hCursor, 0 );
+    /* another thread registered it after the check above */
+    if ((atom = find_class_atom( user32_module, &name ))) descr->atom = atom;
 }
 
-static void register_builtins(void)
+/***********************************************************************
+ *           register_builtin_classes
+ *
+ * Loading the classes' cursors and user32's part (it loads uxtheme.dll)
+ * take the loader lock, so no thread waits here for another one: a thread
+ * that held the loader lock (in a DllMain) while another one held a once
+ * here and waited for the loader lock would never return. Each thread
+ * registers the classes still missing, and the first one runs user32's part.
+ */
+void register_builtin_classes(void)
 {
+    static LONG registered, user32_init;
     struct builtin_class_descr *edit_class = builtin_classes + NTUSER_WNDPROC_EDIT;
-    ULONG ret_len, i;
+    ULONG ret_len, i, error;
     void *ret_ptr;
 
+    if (ReadAcquire( &registered )) return;
+    error = RtlGetLastWin32Error();  /* a class another thread registered first fails here */
+
     /* 64-bit Windows use sizeof(UINT64) for all processes, while 32-bit Windows use 6 for extra
      * bytes size. Civilization II depends on the size being 6, so we use that even in wow64. */
     if (sizeof(void *) == 4 || NtCurrentTeb()->WowTebOffset) edit_class->extra = 6;
 
     for (i = 0; i < ARRAY_SIZE(builtin_classes); i++) if (builtin_classes[i].name) register_builtin( i );
-    KeUserModeCallback( NtUserInitBuiltinClasses, NULL, 0, &ret_ptr, &ret_len );
-}
-
-/***********************************************************************
- *           register_builtin_classes
- */
-void register_builtin_classes(void)
-{
-    static pthread_once_t init_once = PTHREAD_ONCE_INIT;
-    pthread_once( &init_once, register_builtins );
+    WriteRelease( &registered, 1 );
+    RtlSetLastWin32Error( error );
+    if (!InterlockedExchange( &user32_init, 1 ))
+        KeUserModeCallback( NtUserInitBuiltinClasses, NULL, 0, &ret_ptr, &ret_len );
 }
 
 /***********************************************************************
