+/* A directory past the threshold, just parked, shares the files' budget
+ * from now on: once it is opened again it is live, the client gets its
+ * descriptor uncached, and as the least recently used it is parked again.
+ * Before, it stayed open for good once used, and Java's watch service, which
+ * reads each watched folder's file information, kept one per folder. With
+ * no files budget it stays open once used, as before. */
+static void ps5_track_directory( struct fd *fd )
+{
+    if (!ps5_live_files_limit()) return;
+    fd->ps5_file = 1;
+    fd->ps5_dir = 1;
