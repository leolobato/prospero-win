+static long long poll_budget_us(void)
+{
+    static long long budget = -1;
+
+    if (budget == -1)
+    {
+        const char *value = getenv( "WINE_PS5_POLL_BUDGET_US" );
+        budget = value && *value ? atoll( value ) : POLL_TICK_BUDGET_US;
+        if (budget < 0) budget = POLL_TICK_BUDGET_US;
+    }
+    return budget;
+}
+
+static void poll_tick( void *private )
+{
+    unsigned int turns = list_count( &poll_watches ), listed = 0;
+    struct timespec start;
+
+    poll_timer = NULL;
+    clock_gettime( CLOCK_MONOTONIC, &start );
+    /* a directory released below may take its watch off the list */
+    while (turns-- && !list_empty( &poll_watches ))
+    {
+        struct poll_watch *watch = LIST_ENTRY( list_head( &poll_watches ), struct poll_watch, entry );
+        struct dir *dir = watch->dir;
+
+        if (watch->due <= current_time)
+        {
+            /* the watches left are listed first at the next tick */
+            if (listed && poll_elapsed_us( &start ) >= poll_budget_us()) break;
+            /* a report may complete the watch's last request and release its directory */
+            grab_object( dir );
+            poll_watch_list( watch );
+            listed++;
+            list_remove( &watch->entry );
+            list_add_tail( &poll_watches, &watch->entry );
+            release_object( dir );
+        }
+        else
+        {
+            list_remove( &watch->entry );
+            list_add_tail( &poll_watches, &watch->entry );
+        }
+    }
+    if (!list_empty( &poll_watches ))
+        poll_timer = add_timeout_user( current_time + POLL_MIN_INTERVAL, poll_tick, NULL );
 }
 
