+ * there instead (*report): the count starts again, so a program that keeps the
+ * page read-only gets one report per SUBPAGE_HOT_STEPS writes and the rest are
+ * stepped, not a loop. Any other hot access cannot be reported to the program
+ * (a read, or a write beside an inaccessible page that the program never touches,
+ * as a garbage collector's heap): the host page keeps the union of its pages'
+ * protections, as without this scheme, until one of them changes.
+ */
+static BOOL subpage_hot( char *page, BOOL write, char **report )
 {
     unsigned int slot = ((UINT_PTR)page / host_page_size) % ARRAY_SIZE(subpage_heat);
-    char *ro = NULL;
     size_t i;
     BYTE vprot;
 
@@ -5234,17 +5276,20 @@ static char *subpage_hot_write( char *page )
     {
         subpage_heat[slot].page = page;
         subpage_heat[slot].steps = 0;
+        subpage_heat[slot].whole = FALSE;
     }
-    if (++subpage_heat[slot].steps < SUBPAGE_HOT_STEPS) return NULL;
